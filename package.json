{
  "name": "yenwatch",
  "version": "1.0.0",
  "private": true,
  "description": "Raspberry Pi 상주형 엔화(JPY/KRW) 환율 모니터링 봇 — Discord + Notion + SQLite",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "cli:dist": "node dist/cli/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop yenwatch",
    "pm2:restart": "pm2 restart yenwatch --update-env",
    "pm2:delete": "pm2 delete yenwatch",
    "pm2:status": "pm2 describe yenwatch",
    "pm2:logs": "pm2 logs yenwatch",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save",
    "deploy:pm2": "npm ci && npm run build && pm2 startOrRestart ecosystem.config.cjs --update-env && pm2 save",
    "check": "tsx scripts/check-health.ts",
    "discord:register": "tsx scripts/register-discord-commands.ts",
    "notion:check": "tsx scripts/setup-notion.ts",
    "backup": "tsx scripts/backup-db.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true vitest run --project integration"
  },
  "dependencies": {
    "@notionhq/client": "^5.1.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "iconv-lite": "^0.6.3",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
