# ============================================================
# YenWatch 환경변수 예시
# ------------------------------------------------------------
# 사용법:
#   cp .env.example .env
#   chmod 600 .env
#   npm run cli        # 대화형으로 값 입력/검증 가능
#
# 주의: 아래 값은 모두 가짜 예시입니다. 실제 토큰을 커밋하지 마세요.
# ============================================================

# ---------- 실행 환경 ----------
NODE_ENV=production
TZ=Asia/Seoul
LOG_LEVEL=info

# ---------- Discord ----------
# Developer Portal > Bot > Reset Token 으로 발급한 값
DISCORD_TOKEN=MTIzNDU2Nzg5MDEyMzQ1Njc4.EXAMPLE.FAKE_TOKEN_DO_NOT_USE
# Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=123456789012345678
# 개발자 모드로 복사한 서버(길드) ID
DISCORD_GUILD_ID=123456789012345678
# 환율 상태 메시지를 표시할 채널 ID
DISCORD_CHANNEL_ID=123456789012345678
# /yen-refresh 를 실행할 수 있는 사용자 ID (쉼표 구분, 비우면 전원 거부)
DISCORD_ALLOWED_USER_IDS=123456789012345678,987654321098765432

# ---------- Notion (상태) ----------
NOTION_ENABLED=true
# Internal Integration Secret (ntn_ 또는 secret_ 로 시작)
NOTION_TOKEN=ntn_EXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE
# database ID 가 아니라 data source ID 입니다. README 12.2 참고.
NOTION_DATA_SOURCE_ID=00000000-0000-0000-0000-000000000000
# 비워두면 자동 탐색/생성 후 SQLite 에 저장합니다.
NOTION_STATUS_PAGE_ID=

# ---------- Notion (이력, 선택) ----------
NOTION_HISTORY_ENABLED=false
NOTION_HISTORY_DATA_SOURCE_ID=
NOTION_HISTORY_INTERVAL_MINUTES=60

# ---------- 수집 ----------
# 1순위: 네이버 증권 JSON API. 비우면 기본값, off 면 HTML 파서만 사용.
NAVER_JPY_API_URL=https://api.stock.naver.com/marketindex/exchange/FX_JPYKRW
# 2순위(폴백): 예전 HTML 페이지. 2026-09 부터 stock.naver.com 으로 리다이렉트되어 보통 파싱 실패.
NAVER_JPY_URL=https://finance.naver.com/marketindex/exchangeDetail.naver?marketindexCd=FX_JPYKRW
SCRAPE_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_MS=10000
STALE_AFTER_MINUTES=5
FAILURE_ALERT_THRESHOLD=5

# ---------- 유효성 범위 (100 JPY 당 KRW) ----------
MIN_VALID_JPY100_KRW=100
MAX_VALID_JPY100_KRW=2000

# ---------- 목표 환율 알림 (/yen-alert) ----------
# 알림이 한 번 울린 뒤, 환율이 목표선에서 이만큼(KRW) 벗어나야 다시 감시합니다.
# 경계선 근처에서 환율이 흔들릴 때 매분 멘션이 가는 것을 막습니다.
ALERT_REARM_MARGIN_KRW=1

# ---------- 저장소 ----------
SQLITE_PATH=./data/yenwatch.db
DATA_RETENTION_DAYS=365
