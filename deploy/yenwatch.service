; ============================================================
; YenWatch systemd 서비스 유닛
; ------------------------------------------------------------
; 설치:
;   sudo cp deploy/yenwatch.service /etc/systemd/system/yenwatch.service
;   sudo systemctl daemon-reload
;   sudo systemctl enable yenwatch
;   sudo systemctl start yenwatch
;
; 주의: User/Group/ExecStart 의 node 경로는 환경에 맞게 바꿔야 합니다.
;       deploy/install.sh 를 쓰면 자동으로 치환됩니다.
; ============================================================

[Unit]
Description=YenWatch Discord and Notion Exchange Rate Bot
Documentation=https://github.com/your-account/yenwatch
; 네트워크가 실제로 연결된 뒤에 시작 (부팅 직후 DNS 실패 방지)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/yenwatch

; .env 를 systemd 가 직접 주입한다. 파일 권한은 600 이어야 한다.
EnvironmentFile=/opt/yenwatch/.env

; node 실행 경로는 `which node` 결과로 치환하세요 (nvm 사용 시 경로가 다름)
ExecStart=/usr/bin/node /opt/yenwatch/dist/index.js

; ---------- 재시작 정책 ----------
Restart=on-failure
RestartSec=10
; 5분 안에 5회 이상 실패하면 재시작을 멈추고 실패 상태로 둔다 (무한 재시작 루프 방지)
StartLimitIntervalSec=300
StartLimitBurst=5

; ---------- 종료 처리 ----------
; SIGTERM 을 받으면 앱이 진행 중인 수집을 마치고 SQLite 를 안전하게 닫는다.
KillSignal=SIGTERM
TimeoutStopSec=30
KillMode=mixed

; ---------- 로깅 ----------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yenwatch

; ---------- 보안 강화 ----------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
; SQLite 파일과 백업을 쓰기 위해 이 경로만 쓰기 허용
ReadWritePaths=/opt/yenwatch/data

; ---------- 실행 환경 ----------
Environment=NODE_ENV=production
Environment=TZ=Asia/Seoul

[Install]
WantedBy=multi-user.target
